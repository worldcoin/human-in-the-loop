{
	"name": "@worldcoin/human-in-the-loop",
	"type": "module",
	"version": "0.2.1",
	"description": "Human-in-the-loop approval workflows using World ID",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/worldcoin/human-in-the-loop.git",
		"directory": "packages/human-in-the-loop"
	},
	"homepage": "https://github.com/worldcoin/human-in-the-loop#readme",
	"bugs": {
		"url": "https://github.com/worldcoin/human-in-the-loop/issues"
	},
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.ts"
			},
			"import": "./dist/index.js"
		},
		"./workflows": {
			"types": {
				"import": "./dist/workflows/index.d.ts"
			},
			"import": "./dist/workflows/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun --bun tsup",
		"dev": "bun --bun tsup --watch",
		"test": "bun test ./tests",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"ai": ">=5.0.0",
		"workflow": ">=4.2.0-beta.76"
	},
	"peerDependenciesMeta": {
		"workflow": {
			"optional": true
		}
	},
	"dependencies": {
		"@worldcoin/idkit-core": "^4.1.1",
		"@worldcoin/idkit-server": "^1.1.1"
	},
	"devDependencies": {
		"ai": "^5.0.76",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"workflow": "^4.2.0-beta.70"
	}
}
